# Postgres connection string. On Supabase use the "Transaction pooler" URI (port 6543).
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# Google AI Studio API key (free tier is enough): https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Default gemini-2.5-flash; if Google reports it busy or rate-limited, the fallbacks are tried in order.
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_FALLBACK_MODELS=gemini-flash-latest,gemini-flash-lite-latest

# Any secret string. Needed on /setup to reset the database to the original data.
ADMIN_TOKEN=change-me
