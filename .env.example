# Postgres connection string. On Supabase use the "Transaction pooler" URI (port 6543).
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# Google AI Studio API key (free tier is enough): https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Defaults to Google's auto-updating alias for the newest Flash model.
GEMINI_MODEL=gemini-flash-latest

# Any secret string. Needed on /setup to initialise or reset the database.
ADMIN_TOKEN=change-me
